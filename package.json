{
  "name": "eslint-plugin-jest-extended",
  "version": "3.0.1",
  "description": "Eslint rules for Jest Extended",
  "keywords": [
    "jest",
    "eslint",
    "eslintplugin",
    "eslint-plugin",
    "eslint-plugin-jest"
  ],
  "homepage": "https://github.com/Aesthermortis/eslint-plugin-jest-extended#readme",
  "bugs": {
    "url": "https://github.com/Aesthermortis/eslint-plugin-jest-extended/issues"
  },
  "repository": "https://github.com/Aesthermortis/eslint-plugin-jest-extended",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.js",
  "types": "./index.d.ts",
  "files": [
    "dist",
    "docs",
    "index.d.ts",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "prebuild": "node -e \"const fs=require('node:fs'); for (const dir of ['dist', 'coverage', '.cache']) fs.rmSync(dir,{recursive:true,force:true});\"",
    "build": "rollup -c",
    "docs:check": "npm run build && eslint-doc-generator --check",
    "docs:generate": "npm run build && eslint-doc-generator",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "lint": "eslint . --cache --cache-strategy content --cache-location .cache/eslint/ --report-unused-disable-directives",
    "lint:fix": "eslint . --fix --cache --cache-strategy content --cache-location .cache/eslint/ --report-unused-disable-directives",
    "prepack": "npm run build",
    "prepare": "husky && npm run build",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js",
    "test:coverage": "node --experimental-vm-modules node_modules/jest/bin/jest.js --coverage",
    "test:update": "npm run test:coverage -- --updateSnapshot",
    "test:watch": "node --experimental-vm-modules node_modules/jest/bin/jest.js --watch",
    "typecheck": "tsc -p . --noEmit"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.5.3",
    "@commitlint/config-conventional": "^21.0.0",
    "@eslint-community/eslint-plugin-eslint-comments": "^4.7.1",
    "@eslint/js": "^10.0.1",
    "@homer0/prettier-plugin-jsdoc": "^11.1.0",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-typescript": "^12.3.0",
    "@tsconfig/node24": "^24.0.4",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.0.0",
    "@typescript-eslint/utils": "^8.59.2",
    "dedent": "^1.0.0",
    "eslint": "^10.3.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-doc-generator": "^3.3.2",
    "eslint-plugin-eslint-plugin": "^7.3.3",
    "eslint-plugin-jest": "^29.15.2",
    "eslint-plugin-n": "^18.0.1",
    "husky": "^9.1.7",
    "jest": "^30.4.2",
    "lint-staged": "^17.0.3",
    "prettier": "^3.8.3",
    "prettier-plugin-packagejson": "^3.0.2",
    "rollup": "^4.60.3",
    "ts-jest": "^29.4.9",
    "typescript": "^5.0.0",
    "typescript-eslint": "^8.59.2"
  },
  "peerDependencies": {
    "eslint": "^10.0.0"
  },
  "packageManager": "npm@11.0.0",
  "engines": {
    "node": ">=24.0.0",
    "npm": ">=11.0.0"
  }
}
